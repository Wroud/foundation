{
  "name": "@wroud/vite-plugin-playground",
  "type": "module",
  "version": "1.0.0",
  "sideEffects": [],
  "exports": {
    ".": "./lib/index.js",
    "./assets/*": "./src/app/assets/*",
    "./*": "./lib/*.js"
  },
  "scripts": {
    "ci:release": "ci release --prefix vite-plugin-playground-v",
    "ci:git-tag": "ci git-tag --prefix vite-plugin-playground-v",
    "ci:release-github": "ci release-github --prefix vite-plugin-playground-v",
    "build": "tsc -b",
    "watch:tsc": "tsc -b -w",
    "clear": "rimraf lib",
    "test": "tests-runner"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "public",
    "lib",
    "src",
    "src/**/*.svg",
    "src/**/*.css",
    "!lib/**/*.d.ts.map",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts",
    "!lib/**/*.test.d.ts.map",
    "!lib/**/*.test.js.map",
    "!lib/tests",
    "!.tsbuildinfo"
  ],
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/picomatch": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "@wroud/ci": "workspace:^0",
    "@wroud/playground-react": "workspace:^",
    "@wroud/tests-runner": "workspace:*",
    "@wroud/tsconfig": "workspace:*",
    "@wroud/vite-plugin-ssg": "workspace:^",
    "react": "^19",
    "react-dom": "^19",
    "rimraf": "^6",
    "vite": "^8",
    "vitest": "^3"
  },
  "peerDependencies": {
    "@wroud/playground-react": "workspace:^",
    "@wroud/vite-plugin-ssg": "workspace:^",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "dependencies": {
    "@ariakit/react": "^0",
    "@tailwindcss/typography": "^0",
    "@vscode/codicons": "^0",
    "@wroud/navigation": "workspace:^",
    "@wroud/playground": "workspace:^",
    "@wroud/react-reactive-value": "workspace:^",
    "@wroud/react-split-view": "workspace:^",
    "@wroud/react-tree": "workspace:^",
    "front-matter": "^4",
    "magic-string": "^0",
    "picomatch": "^4",
    "react-markdown": "^10",
    "tailwindcss": "^4",
    "tinyglobby": "^0",
    "typescript": "^6"
  }
}
