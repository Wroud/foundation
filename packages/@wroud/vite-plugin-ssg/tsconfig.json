{
  "extends": "@wroud/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "rootDir": "src",
    "rootDirs": [
      "src"
    ],
    "outDir": "lib",
    "incremental": true,
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@wroud/vite-plugin-ssg/react/components/renderContextAccessor": [
        "./src/react/components/renderContextAccessor.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../di"
    },
    {
      "path": "../di-react"
    }
  ]
}
